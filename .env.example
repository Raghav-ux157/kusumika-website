# ==============================================================================
# Kusumika - Environment Variables (Development & Production Template)
# ==============================================================================

# NEXT.JS APPLICATION URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SUPABASE (Postgres, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# RAZORPAY PAYMENT GATEWAY (TEST MODE)
# Get keys at: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyId123
RAZORPAY_KEY_SECRET=your_test_secret_here

# SHIPROCKET LOGISTICS & SHIPPING (TEST/SANDBOX MODE)
SHIPROCKET_EMAIL=operations@kusumika.com
SHIPROCKET_PASSWORD=your_shiprocket_test_password
SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1/external

# WHATSAPP CLOUD API (META FOR DEVELOPERS)
WHATSAPP_API_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id

# RESEND / EMAIL NOTIFICATIONS
RESEND_API_KEY=re_your_resend_api_key_here
NOTIFICATION_EMAIL_FROM=orders@kusumika.com
NOTIFICATION_EMAIL_TO=patroncare@kusumika.com
